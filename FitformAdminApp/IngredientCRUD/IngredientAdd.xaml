<Window x:Class="FitformAdminApp.IngredientCRUD.IngredientAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Új hozzávaló hozzáadása" Height="400" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <TextBox x:Name="tbName" Text="Név" Margin="0,5"/>
            <TextBox x:Name="tbCalPer100g" Text="Kalória / 100g" Margin="0,5"/>
            <TextBox x:Name="tbDescription" Text="Leírás" Margin="0,5"/>
            <TextBox x:Name="tbImageUrl" Text="Kép URL" Margin="0,5"/>
            <TextBox x:Name="tbCategoryId" Text="Kategória ID" Margin="0,5"/>
            <Button Content="Hozzáadás" x:Name="BtnAdd" Click="BtnAdd_Click"  Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>
